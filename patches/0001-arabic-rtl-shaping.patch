+    /** One styled run of a row, collected so rows with an RTL base direction can be reordered before drawing. */
+    private static final class RunInfo {
+        int startColumn, widthColumns, startIndex, widthChars, cursorColor;
+        float mes, leftPx, widthPx;
+        long style;
+        boolean reverse, rtl;
+    }
+
+    private final java.util.ArrayList<RunInfo> mRuns = new java.util.ArrayList<>();
+
+    private void addRun(int startColumn, int widthColumns, int startIndex, int widthChars, float mes,
+                        int cursorColor, long style, boolean reverse, boolean rtl) {
+        RunInfo r = new RunInfo();
+        r.startColumn = startColumn;
+        r.leftPx = startColumn * mFontWidth;
+        r.widthPx = widthColumns * mFontWidth;
+        r.widthColumns = widthColumns;
+        r.startIndex = startIndex;
+        r.widthChars = widthChars;
+        r.mes = mes;
+        r.cursorColor = cursorColor;
+        r.style = style;
+        r.reverse = reverse;
+        r.rtl = rtl;
+        mRuns.add(r);
+    }
+
+    /** Draws the collected runs of one row. If the first strong character is RTL, runs are laid out right-to-left. */
+    private void drawRow(Canvas canvas, char[] line, int[] palette, float y, int cursorShape) {
+        boolean rtlBase = false;
+        boolean hasBox = false;
+        for (RunInfo r : mRuns) {
+            for (int j = r.startIndex; j < r.startIndex + r.widthChars; j++) {
+                if (line[j] >= 0x2500 && line[j] <= 0x257F) { hasBox = true; break; }
+            }
+        }
+        // Rows with box-drawing characters (tables, frames) keep their column layout.
+        if (!hasBox) {
+            for (RunInfo r : mRuns) {
+                if (r.rtl) { rtlBase = true; break; }
+                if (hasStrongLtr(line, r.startIndex, r.widthChars)) break;
+            }
+        }
+        if (rtlBase) reorderRuns(line);
+        // Two passes: all backgrounds/cursor first, then all text, so a run's background can never
+        // paint over text of another run that was moved by the reordering.
+        if (rtlBase) {
+            // Packing moves runs, so also paint each run's background at its ORIGINAL cells; otherwise the
+            // part of the row the text no longer covers shows the black terminal background.
+            for (RunInfo r : mRuns) {
+                drawTextRun(canvas, line, palette, y, r.startColumn * mFontWidth, r.widthColumns * mFontWidth, r.widthColumns,
+                    r.startIndex, r.widthChars, r.mes, 0, cursorShape, r.style, r.reverse, r.rtl, false);
+            }
+        }
+        for (int pass = 0; pass < 2; pass++) {
+            for (RunInfo r : mRuns) {
+                drawTextRun(canvas, line, palette, y, r.leftPx, r.widthPx, r.widthColumns, r.startIndex, r.widthChars, r.mes,
+                    r.cursorColor, cursorShape, r.style, r.reverse, r.rtl, pass == 1);
+            }
+        }
+        mRuns.clear();
+    }
+
+    private RunInfo splitRun(RunInfo r, int chars, boolean atStart, boolean rtl) {
+        // Cuts {@code chars} single-width blanks off one end of r and returns them as a separate run.
+        RunInfo b = new RunInfo();
+        b.widthColumns = chars;
+        b.widthChars = chars;
+        b.mes = chars * mFontWidth;
+        b.style = r.style;
+        b.reverse = r.reverse;
+        b.rtl = rtl;
+        if (atStart) {
+            b.startColumn = r.startColumn;
+            b.startIndex = r.startIndex;
+            r.startColumn += chars;
+            r.startIndex += chars;
+        } else {
+            b.startColumn = r.startColumn + r.widthColumns - chars;
+            b.startIndex = r.startIndex + r.widthChars - chars;
+        }
+        r.widthColumns -= chars;
+        r.widthChars -= chars;
+        r.mes -= b.mes;
+        b.leftPx = b.startColumn * mFontWidth;
+        b.widthPx = chars * mFontWidth;
+        r.leftPx = r.startColumn * mFontWidth;
+        r.widthPx = r.widthColumns * mFontWidth;
+        return b;
+    }
+
+    /** Neutral characters (blanks and common punctuation) that take the base direction between runs. */
+    private static boolean isNeutralChar(char c) {
+        return c == ' ' || c == '.' || c == ',' || c == ':' || c == ';' || c == '!' || c == '?' || c == '-'
+            || c == '(' || c == ')' || c == '"' || c == '\'';
+    }
+
+    private static boolean allNeutral(char[] line, RunInfo r) {
+        for (int j = r.startIndex; j < r.startIndex + r.widthChars; j++) if (!isNeutralChar(line[j])) return false;
+        return true;
+    }
+
+    private static boolean allBlank(char[] line, RunInfo r) {
+        for (int j = r.startIndex; j < r.startIndex + r.widthChars; j++) if (line[j] != ' ') return false;
+        return true;
+    }
+
+    private void reorderRuns(char[] line) {
+        // Find the last run holding content (non-blank text or the cursor); everything after stays in place.
+        int last = -1;
+        for (int i = mRuns.size() - 1; i >= 0 && last < 0; i--) {
+            RunInfo r = mRuns.get(i);
+            if (r.cursorColor != 0 || !allBlank(line, r)) last = i;
+        }
+        if (last < 0) return;
+
+        java.util.ArrayList<RunInfo> head = new java.util.ArrayList<>(mRuns.subList(0, last + 1));
+        java.util.ArrayList<RunInfo> tailRuns = new java.util.ArrayList<>(mRuns.subList(last + 1, mRuns.size()));
+
+        // Split trailing blanks off the last content run so they do not travel with the text.
+        RunInfo lr = head.get(head.size() - 1);
+        if (lr.cursorColor == 0 && !allBlank(line, lr)) {
+            int trailing = 0;
+            for (int j = lr.startIndex + lr.widthChars - 1; j >= lr.startIndex && line[j] == ' '; j--) trailing++;
+            if (trailing > 0) tailRuns.add(0, splitRun(lr, trailing, false, false));
+        }
+
+        // Neutral blanks between runs of different direction take the (RTL) base direction, so a blank next
+        // to RTL text becomes part of the RTL group instead of sticking to the Latin word.
+        java.util.ArrayList<RunInfo> out = new java.util.ArrayList<>();
+        for (int i = 0; i < head.size(); i++) {
+            RunInfo r = head.get(i);
+            boolean prevRtl = !out.isEmpty() && out.get(out.size() - 1).rtl;
+            boolean nextRtl = i + 1 < head.size() && head.get(i + 1).rtl;
+            if (!r.rtl && r.cursorColor == 0) {
+                if (allNeutral(line, r)) {
+                    if (prevRtl || nextRtl) r.rtl = true;
+                } else {
+                    int lead = 0;
+                    while (lead < r.widthChars && isNeutralChar(line[r.startIndex + lead])) lead++;
+                    if (prevRtl && lead > 0) out.add(splitRun(r, lead, true, true));
+                    int trail = 0;
+                    for (int j = r.startIndex + r.widthChars - 1; j >= r.startIndex && isNeutralChar(line[j]); j--) trail++;
+                    if (nextRtl && trail > 0) {
+                        out.add(r);
+                        out.add(splitRun(r, trail, false, true));
+                        continue;
+                    }
+                }
+            }
+            out.add(r);
+        }
+
+        // Pack the runs by their real width (shaped Arabic is narrower than one cell per letter).
+        int n = out.size();
+        float[] widths = new float[n];
+        boolean[] rtl = new boolean[n];
+        float[] start = new float[n];
+        for (int i = 0; i < n; i++) {
+            RunInfo r = out.get(i);
+            float w = r.widthColumns * mFontWidth;
+            if (r.rtl && Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
+                int end = r.startIndex + r.widthChars;
+                w = (float) Math.ceil(mTextPaint.getRunAdvance(line, r.startIndex, end, r.startIndex, end, true, end));
+            }
+            r.widthPx = w;
+            widths[i] = w;
+            rtl[i] = r.rtl;
+        }
+        RtlRunLayout.layout(widths, rtl, n, start);
+        for (int i = 0; i < n; i++) out.get(i).leftPx = start[i];
+
+        mRuns.clear();
+        mRuns.addAll(out);
+        mRuns.addAll(tailRuns);
+    }
+
+    private static boolean hasStrongLtr(char[] line, int from, int length) {
+        for (int i = from; i < from + length; i++) {
+            if (Character.isLetter(line[i]) && !isRtlCodePoint(line[i])) return true;
+        }
+        return false;
+    }
+
+    /** True if the next non-neutral character at or after {@code from} is right-to-left. */
+    private static boolean nextStrongIsRtl(char[] line, int from, int used) {
+        for (int i = from; i < used; i++) {
+            int cp = line[i];
+            if (isRtlNeutral(cp)) continue;
+            return isRtlCodePoint(cp);
+        }
+        return false;
+    }
+
+    /** True for Hebrew, Arabic, Syriac, Thaana, N'Ko, Arabic Extended and the Arabic/Hebrew presentation forms. */
+    private static boolean isRtlCodePoint(int cp) {
+        return (cp >= 0x0590 && cp <= 0x08FF) || (cp >= 0xFB1D && cp <= 0xFDFF) || (cp >= 0xFE70 && cp <= 0xFEFF);
+    }
+
+    /** Characters that may continue a right-to-left run once it has started (spaces, punctuation, digits). */
+    private static boolean isRtlNeutral(int cp) {
+        return cp == ' ' || (cp >= '0' && cp <= '9') || cp == '.' || cp == ',' || cp == ':' || cp == ';'
+            || cp == '!' || cp == '?' || cp == '-' || cp == '(' || cp == ')' || cp == '"' || cp == '\'';
+    }
+
     public float getFontWidth() {
         return mFontWidth;
     }
