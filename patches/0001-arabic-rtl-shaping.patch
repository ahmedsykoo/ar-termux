+package com.termux.view;
+
+/**
+ * Visual ordering of text runs on a terminal row whose base direction is right-to-left.
+ * Pure logic (no Android classes) so it can be unit tested.
+ */
+final class RtlRunLayout {
+    private RtlRunLayout() {}
+
+    /**
+     * Runs are given in logical order and are contiguous. Consecutive runs with the same direction form a group.
+     * Groups are placed in reverse order (right-to-left paragraph); inside an RTL group the runs are reversed as
+     * well, inside an LTR group they keep their order.
+     *
+     * @param widths  width (any unit) of each of the first {@code n} runs
+     * @param rtl     direction of each run
+     * @param n       number of runs to lay out
+     * @param start   output: visual start position of each run (block anchored at column 0)
+     */
+    static void layout(float[] widths, boolean[] rtl, int n, float[] start) {
+        int[] groupStart = new int[n];
+        int groups = 0;
+        for (int i = 0; i < n; i++) {
+            if (i == 0 || rtl[i] != rtl[i - 1]) groupStart[groups++] = i;
+        }
+        float col = 0;
+        for (int g = groups - 1; g >= 0; g--) {
+            int from = groupStart[g];
+            int to = (g + 1 < groups) ? groupStart[g + 1] : n; // exclusive
+            if (rtl[from]) {
+                for (int i = to - 1; i >= from; i--) { start[i] = col; col += widths[i]; }
+            } else {
+                for (int i = from; i < to; i++) { start[i] = col; col += widths[i]; }
+            }
+        }
+    }
+}
